{
    "name": "restruct/silverstripe-queuedjobs-enhancements",
    "description": "Jobs that start within a second, live progress in the browser, queued method calls and emails, and opt-in safeguards for busy queues, for symbiote/silverstripe-queuedjobs",
    "keywords": [
        "silverstripe",
        "silverstripe-module",
        "queuedjobs",
        "background-jobs",
        "job-queue",
        "async"
    ],
    "type": "silverstripe-vendormodule",
    "license": "MIT",
    "authors": [
        {
            "name": "Restruct",
            "email": "dev@restruct.nl",
            "homepage": "https://restruct.nl"
        }
    ],
    "require": {
        "php": "^8.1",
        "silverstripe/framework": "^5.4 || ^6",
        "symbiote/silverstripe-queuedjobs": "^5 || ^6"
    },
    "autoload": {
        "psr-4": {
            "Restruct\\QueuedJobsEnhancements\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Restruct\\QueuedJobsEnhancements\\Tests\\": "tests/"
        }
    },
    "extra": {
        "expose": [
            "client/"
        ]
    }
}
